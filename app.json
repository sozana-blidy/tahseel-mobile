{
  "expo": {
    "name": "تحصيل",
    "slug": "tahseel",
    "scheme": "tahseel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.tahseel.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E3F1ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E6B5C"
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (via expo-background-task): R8 stripped the Room-generated WorkDatabase_Impl constructor -> crash at launch\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }\n-keep class expo.modules.backgroundtask.** { *; }\n-keep class expo.modules.taskmanager.** { *; }"
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "./plugins/withCmakeVersion",
        {
          "version": "4.0.2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
